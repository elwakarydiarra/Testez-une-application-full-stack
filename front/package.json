{
  "name": "yoga-app",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:ci": "ng run yoga:e2e-ci",
    "e2e:coverage": "npx nyc report --reporter=lcov --reporter=text-summary",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "precy:run": "rm -rf .nyc_output coverage",
    "cy:run": "COVERAGE=true cypress run",
    "cy:open": "COVERAGE=true cypress open",
    "start:cov": "ng run yoga:serve-coverage",
    "test:e2e:cov": "start-server-and-test \"ng run yoga:serve-coverage\" http-get://localhost:4200 \"COVERAGE=true cypress run\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "14.2.0",
    "@angular/cdk": "14.2.0",
    "@angular/common": "14.2.0",
    "@angular/compiler": "14.2.0",
    "@angular/core": "14.2.0",
    "@angular/flex-layout": "14.0.0-beta.40",
    "@angular/forms": "14.2.0",
    "@angular/material": "14.2.0",
    "@angular/platform-browser": "14.2.0",
    "@angular/platform-browser-dynamic": "14.2.0",
    "@angular/router": "14.2.0",
    "rxjs": "7.5.6",
    "tslib": "2.4.0",
    "zone.js": "0.11.8"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^14.1.0",
    "@angular-devkit/build-angular": "14.2.1",
    "@angular-eslint/builder": "14.0.3",
    "@angular-eslint/eslint-plugin": "14.0.3",
    "@angular-eslint/eslint-plugin-template": "14.0.3",
    "@angular-eslint/schematics": "14.0.3",
    "@angular-eslint/template-parser": "14.0.3",
    "@angular/cli": "14.2.1",
    "@angular/compiler-cli": "14.2.0",
    "@briebug/jest-schematic": "4.0.0",
    "@cypress/code-coverage": "^3.14.6",
    "@cypress/schematic": "2.0.3",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@jsdevtools/coverage-istanbul-loader": "^3.0.5",
    "@types/cypress": "^0.1.6",
    "@types/cypress__code-coverage": "^3.10.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "5.35.1",
    "@typescript-eslint/parser": "5.35.1",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^10.11.0",
    "eslint": "8.23.0",
    "istanbul-lib-coverage": "3.2.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.1",
    "jest-marbles": "3.0.3",
    "jest-preset-angular": "^13.1.6",
    "lcov-parse": "^1.0.0",
    "nyc": "15.1.0",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.0.13",
    "ts-jest": "^29.4.1",
    "typescript": "4.7.4",
    "webpack": "5.74.0"
  }
}
